{
 "id": "dup_scan",
 "title": "Двойники (одинаковые файлы) по содержимому",
 "version": 1,
 "kind": "report",
 "group": "файлы",
 "needs_creo": false,
 "class": "Р",
 "engine": "dup_scan.py",
 "gui": "gui.py",
 "gui_bat": "dup_scan_gui.bat",
 "readme": "README.md",
 "cli": ["--help"],
 "inputs": [
  {"name": "roots", "type": "paths", "default": [],
   "desc": "папки для поиска двойников"},
  {"name": "ext", "type": "list", "default": "prt,asm,drw,pdf",
   "desc": "расширения через запятую"},
  {"name": "min_mb", "type": "float", "default": 0.0,
   "desc": "не меньше, МБ; 0 = искать всё"},
  {"name": "mode", "type": "enum", "default": "report",
   "desc": "report = только отчёт; apply = переносить лишнее в _trash_dup"}
 ],
 "outputs": {"report": "отчёт dup_scan", "log": "журнал поиска"},
 "settings": "dup_scan_settings.json",
 "deps": [],
 "approval": false,
 "ui": "ui_common",
 "notes": "Класс Р: ничего не удаляет, лишнее уезжает в _trash_dup рядом с файлом."
}