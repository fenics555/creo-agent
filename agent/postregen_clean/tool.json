{
 "id": "postregen_clean",
 "title": "Очистка пост-регенерации: удаление уравнений и параметров, переименование видов",
 "version": 1,
 "kind": "act",
 "group": "Creo",
 "needs_creo": true,
 "class": "Ж",
 "engine": "plan.py",
 "gui": "gui.py",
 "gui_bat": "postregen_clean_gui.bat",
 "readme": "README.md",
 "cli": ["--mask=*.asm", "--only=имя.asm", "--param=LM_*", "--rename=СТАРОЕ=НОВОЕ", "--limit=100", "--no-postregen"],
 "inputs": [
   {"name": "root", "type": "path", "default": "D:\\AI\\PROBA\\postregen_clean",
    "desc": "папка с моделями (пробы — только в PROBA; Z: только чтение)"},
   {"name": "mask", "type": "string", "default": "*.asm", "desc": "маска файлов"},
   {"name": "postregen", "type": "bool", "default": "да",
    "desc": "очистить уравнения пост-регенерации (file:postregen_relations_set с [])"},
   {"name": "param_masks", "type": "string", "default": "",
    "desc": "удалить параметры по маскам через ; (parameter:delete)"},
   {"name": "rename_map", "type": "string", "default": "",
    "desc": "переименовать виды: СТАРОЕ=НОВОЕ через ; (feature:rename)"}
 ],
 "outputs": {"plan": "log\\postregen_clean\\PLAN_postregen_clean_*.md",
              "report": "log\\reports\\REPORT_postregen_clean_apply_*.md",
              "settings": "data\\postregen_clean_settings.json"},
 "settings": "postregen_clean_settings.json",
 "deps": ["creo_tools", "ui_common"],
 "approval": true,
 "ui": "ui_common",
 "rc": {"0": "применено или проба", "1": "часть шагов не вышла", "2": "нет CREOSON/Creo или нечего делать",
        "3": "нет согласия", "4": "щит: активна другая модель или модель не открылась"},
 "notes": "Класс Ж. План читает уравнения пост-регенерации через CREOSON (по файлу они не читаются) и НИЧЕГО не пишет. Запись — только с согласием и под щитом сверки активной модели (инцидент 03.10.2026). При мёртвом CREOSON — честный отказ RC 2."
}